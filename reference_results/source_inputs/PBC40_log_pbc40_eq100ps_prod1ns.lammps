
units metal
atom_style molecular
atom_modify map yes
newton on
dimension 3
boundary p p p

variable model_file string "./MACE-OFF23_small_2.model-mliap_lammps.pt"

variable T equal 300.0
variable dt equal 0.001
variable tdamp equal 0.1

read_restart restart_pbc40_relaxed.lammps
Reading restart file ...
  restart file = 11 Feb 2026, LAMMPS = 11 Feb 2026
  restoring atom style molecular/kk from restart
  orthogonal box = (-20 -20 -20) to (20 20 20)
  1 by 1 by 1 MPI processor grid
  pair style mliap stores no restart info
  7149 atoms
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     0 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.002 seconds
  read_restart CPU = 0.041 seconds

pair_style mliap unified ${model_file} 0
pair_style mliap unified ./MACE-OFF23_small_2.model-mliap_lammps.pt 0
pair_coeff * * O H

timestep ${dt}
timestep 0.001

thermo_style custom step time temp pe ke etotal press vol
thermo 1000
thermo_modify flush yes

# ============================================================
# STAGE 1: final 100 ps NVT equilibration at 300 K
# ============================================================

print "===== PBC40 FINAL EQUILIBRATION: 100 ps at 300 K ====="
===== PBC40 FINAL EQUILIBRATION: 100 ps at 300 K =====

fix eq all nvt temp ${T} ${T} ${tdamp}
fix eq all nvt temp 300 ${T} ${tdamp}
fix eq all nvt temp 300 300 ${tdamp}
fix eq all nvt temp 300 300 0.1
fix rmomeq all momentum 10 linear 1 1 1

dump deq all custom 1000 traj_pbc40_eq100ps.dump id mol type x y z ix iy iz
dump_modify deq sort id first yes

run 100000

